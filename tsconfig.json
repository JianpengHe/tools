{
  // tsconfig 所在的根目录即为一个项目
  "compilerOptions": {
    "module": "commonjs",
    "target": "ESNext",
    "noImplicitAny": false,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    // 编译产物与目录规范
    "rootDir": "./src", // 核心优化：将源码根目录收敛到 src，避免污染根目录
    "outDir": "./dist", // 编译产物统一输出到 dist，方便一键清空
    "sourceMap": true,
    "declaration": true, // 生成 .d.ts 声明文件
    // 环境与库
    "lib": [
      "ESNext"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    // 调试辅助选项（如果不需要频繁查看日志，可以关掉以加快编译速度）
    "skipLibCheck": true,
    "pretty": true,
    "listFiles": false, // 建议生产环境关闭，避免刷屏
    "listEmittedFiles": false, // 同上
    // "composite": true
  },
  // 简化 include，精准匹配 src 目录
  "include": [
    "src/**/*"
  ],
  // 排除不需要编译的目录
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts"
  ],
}